{
  "mcpServers": {
    "godot-dev-tools": {
      "command": "python3",
      "args": ["/absolute/path/to/GodotDevTools/mcp/mcp_server.py"],
      "env": {
        "GDT_PROJECT_ROOT": "/absolute/path/to/trusted/godot-project",
        "GODOT_BIN": "/absolute/path/to/godot",
        "GDT_MCP_TIMEOUT": "300"
      }
    }
  }
}
