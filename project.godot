; Engine configuration file.
; This root project is the DEMO + TEST project for the GodotDevTools suite.
; Its demo/ content deliberately contains one detectable problem per tool
; (a visual diff, an overflowing UI, a tiny low-contrast label, a huge and a
; duplicated texture, an unused asset, a broken dialogue branch, a lossy
; network case, a patrol enemy, a door interaction, a broken export preset)
; so the test suites can verify every check the tools promise.

config_version=5

[application]

config/name="GodotDevTools - Demo"
run/main_scene="res://demo/main/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://demo/shared/icon.svg"

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="landscape"

[editor_plugins]

enabled=PackedStringArray("res://addons/visual_regression/plugin.cfg", "res://addons/time_machine/plugin.cfg", "res://addons/responsive_ui/plugin.cfg", "res://addons/asset_health/plugin.cfg", "res://addons/dialogue_quest/plugin.cfg", "res://addons/network_sim/plugin.cfg", "res://addons/scene_search/plugin.cfg", "res://addons/accessibility/plugin.cfg", "res://addons/export_doctor/plugin.cfg", "res://addons/batch_profiler/plugin.cfg", "res://addons/schema_migrator/plugin.cfg", "res://addons/collision_matrix/plugin.cfg", "res://addons/proc_anim/plugin.cfg", "res://addons/audio_sandbox/plugin.cfg", "res://addons/leak_hunter/plugin.cfg", "res://addons/input_matrix/plugin.cfg", "res://addons/shader_doctor/plugin.cfg", "res://addons/signal_spy/plugin.cfg", "res://addons/l10n_matrix/plugin.cfg", "res://addons/bt_debugger/plugin.cfg", "res://addons/camera_orch/plugin.cfg", "res://addons/seed_replay/plugin.cfg", "res://addons/whitebox/plugin.cfg", "res://addons/vfs_mock/plugin.cfg", "res://addons/tilemap_rules/plugin.cfg", "res://addons/test_runner/plugin.cfg", "res://addons/thermal_sim/plugin.cfg", "res://addons/prefab_guard/plugin.cfg", "res://addons/doc_gen/plugin.cfg", "res://addons/scene_dependency/plugin.cfg", "res://addons/release_guard/plugin.cfg", "res://addons/naming_conventions/plugin.cfg", "res://addons/subtitle_audit/plugin.cfg", "res://addons/telemetry_schema/plugin.cfg", "res://addons/performance_gate/plugin.cfg", "res://addons/flag_simulator/plugin.cfg", "res://addons/build_size/plugin.cfg", "res://addons/cert_check/plugin.cfg", "res://addons/state_coverage/plugin.cfg", "res://addons/test_priority/plugin.cfg", "res://addons/particle_budget/plugin.cfg", "res://addons/pool_advisor/plugin.cfg", "res://addons/node_paths/plugin.cfg", "res://addons/unused_symbols/plugin.cfg", "res://addons/type_coverage/plugin.cfg", "res://addons/script_complexity/plugin.cfg", "res://addons/duplicate_code/plugin.cfg", "res://addons/export_ranges/plugin.cfg", "res://addons/autoload_graph/plugin.cfg", "res://addons/uid_integrity/plugin.cfg", "res://addons/settings_drift/plugin.cfg", "res://addons/scene_lint/plugin.cfg", "res://addons/loot_sim/plugin.cfg", "res://addons/difficulty_curve/plugin.cfg", "res://addons/damage_sandbox/plugin.cfg", "res://addons/xp_curve/plugin.cfg", "res://addons/crafting_graph/plugin.cfg", "res://addons/achievements/plugin.cfg", "res://addons/wave_budget/plugin.cfg", "res://addons/rng_fairness/plugin.cfg", "res://addons/save_bloat/plugin.cfg", "res://addons/dialogue_vars/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
